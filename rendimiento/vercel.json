{
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?ruta=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "5 10 * * *"
    }
  ]
}